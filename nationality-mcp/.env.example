# Copy to .env next to docker-compose.yml and fill in. Never commit the real .env.

# Optional. Without a key, nationalize.io allows 100 lookups/day per IP.
# Get one at https://nationalize.io — then the limit follows the key, not the office IP.
NATIONALIZE_API_KEY=

# Optional but strongly recommended once the NAS is reachable from the internet.
# Any random string; Claude sends it as `Authorization: Bearer <token>`.
# Generate one with:  openssl rand -hex 32
AUTH_TOKEN=
